{$APP_DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	# App Android (APK) publicado pelo workflow Android em /opt/vanguard/downloads.
	redir /download /download/
	handle /download/* {
		root * /
		# Nunca guardar em cache: a página e o APK mudam a cada versão.
		header Cache-Control "no-store, max-age=0"
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		file_server
	}

	# Arquivos das telas (nome com hash): cache de 1 ano; se não existir (versão antiga), 404 e o app recarrega sozinho.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Páginas: sempre conferem se há versão nova (nada de tela antiga depois de publicar).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
